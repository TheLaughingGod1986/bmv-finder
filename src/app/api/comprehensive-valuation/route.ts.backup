}

/**
 * Estimate bedrooms based on property type and size
 */
function estimateBedrooms(property: any): number {
  if (property.property_type === 'F') return 1; // Flat
  if (property.property_type === 'T') return 3; // Terraced
  if (property.property_type === 'S') return 3; // Semi-detached
  if (property.property_type === 'D') return 4; // Detached
  return 3; // Default
}

/**
 * Estimate floor area based on property type and bedrooms
 */
function estimateFloorArea(property: any): number {
  const bedrooms = estimateBedrooms(property);
  if (property.property_type === 'F') return 50 + (bedrooms * 15); // Flat
  if (property.property_type === 'T') return 70 + (bedrooms * 20); // Terraced
  if (property.property_type === 'S') return 80 + (bedrooms * 25); // Semi-detached
  if (property.property_type === 'D') return 100 + (bedrooms * 30); // Detached
  return 80; // Default
}

/**
 * Estimate plot size based on property type
 */
function estimatePlotSize(property: any): number {
  if (property.property_type === 'F') return 0; // No plot for flats
  if (property.property_type === 'T') return 150; // Small plot for terraced
  if (property.property_type === 'S') return 300; // Medium plot for semi-detached
  if (property.property_type === 'D') return 500; // Large plot for detached
  return 200; // Default
}

/**
 * Estimate last sold price based on market data
 */
function estimateLastSoldPrice(property: any, marketData: any): number {
  const floorArea = estimateFloorArea(property);
  return Math.round(floorArea * marketData.averagePricePerSqm * 0.9); // 10% below market average
}

/**
 * Calculate price per square meter
 */
function calculatePricePerSqm(price: number, floorArea: number): number | null {
  if (!price || !floorArea || floorArea <= 0) return null;
  return Math.round(price / floorArea);
}