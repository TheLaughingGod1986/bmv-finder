{
  "name": "bmv-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "tsx src/tests/testRunner.ts",
    "test:unit": "tsx src/tests/testRunner.ts --unit-only",
    "test:integration": "tsx src/tests/testRunner.ts --integration-only",
    "test:e2e": "tsx src/tests/testRunner.ts --e2e-only",
    "test:performance": "tsx src/tests/testRunner.ts --performance-only",
    "test:security": "tsx src/tests/testRunner.ts --security-only",
    "test:watch": "tsx src/tests/testRunner.ts --watch",
    "test:coverage": "tsx src/tests/testRunner.ts --coverage",
    "test:ci": "tsx src/tests/testRunner.ts --parallel --output json --output-file test-results.json",
    "populate-es": "node scripts/populate-elasticsearch.js",
    "deploy:production": "./scripts/deploy-production.sh",
    "deploy:core": "./scripts/deploy-core.sh",
    "deploy:staging": "vercel --yes",
    "deploy:verify": "./scripts/deploy-verify-retry.sh",
    "health:check": "curl -f ${NEXT_PUBLIC_APP_URL:-https://bmvfinder.com}/api/health-check",
    "security:audit": "npm audit --audit-level=moderate",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.0",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^7.8.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.12",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.539.0",
    "next": "^15.2.4",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "speakeasy": "^2.0.0",
    "stripe": "^18.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "xlsx": "^0.18.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.5",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "eslint": "^9.34.0",
    "jest": "^29.7.0",
    "sharp": "^0.34.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
