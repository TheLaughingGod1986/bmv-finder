{
  "name": "bmv-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "populate-es": "node scripts/populate-elasticsearch.js",
    "deploy:production": "./scripts/deploy-production.sh",
    "deploy:core": "./scripts/deploy-core.sh",
    "deploy:staging": "vercel --yes",
    "deploy:verify": "./scripts/deploy-verify-retry.sh",
    "health:check": "curl -f ${NEXT_PUBLIC_APP_URL:-https://bmvfinder.com}/api/health-check",
    "security:audit": "npm audit --audit-level=moderate",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.1.1",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^7.8.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "next": "^15.2.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "stripe": "^18.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.5",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "sharp": "^0.34.3",
    "typescript": "^5.8.3"
  }
}
