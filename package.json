{
  "name": "bmv-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "populate-es": "node scripts/populate-elasticsearch.js",
    "populate-es-continue": "node --expose-gc scripts/populate-elasticsearch-continue.js",
    "update-es": "node scripts/update-elasticsearch.js",
    "update-es-incremental": "node scripts/incremental-update.js",
    "index-recent-sales": "node scripts/populate-recent-sales.js",
    "test-hpi": "node src/testHpiSystem.js",
    "test-hpi-upload": "node src/testHpiSystem.js --mode upload",
    "test-hpi-search": "node src/testHpiSystem.js --mode search",
    "test-hpi-api": "node src/testHpiSystem.js --mode api-disabled",
    "test-hpi-errors": "node src/testHpiSystem.js --mode error-handling",
    "deploy:production": "./scripts/deploy-production.sh",
    "deploy:core": "./scripts/deploy-core.sh",
    "deploy:staging": "vercel --yes",
    "setup:infrastructure": "./scripts/setup-production-infrastructure.sh",
    "setup:monitoring": "./scripts/setup-monitoring.sh",
    "health:check": "curl -f https://your-domain.com/api/health-check",
    "security:audit": "npm audit --audit-level=moderate",
    "performance:test": "lighthouse https://your-domain.com --output=json --output-path=./lighthouse-report.json",
    "backup:database": "node scripts/backup-database.js",
    "monitor:status": "node scripts/monitor-status.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.18.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^7.4.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/supabase-js": "^2.50.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.0",
    "critters": "^0.0.25",
    "csv-parse": "^6.0.0",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.5.2",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "eslint-config-next": "^15.3.4",
    "fast-csv": "^5.0.2",
    "framer-motion": "^12.23.3",
    "fuzzball": "^2.2.2",
    "lucide-react": "^0.525.0",
    "next": "^15.2.4",
    "node-fetch": "^3.3.2",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-intersection-observer": "^9.8.0",
    "redis": "^5.6.0",
    "string-similarity": "^4.0.4",
    "stripe": "^18.3.0",
    "tailwind-merge": "^3.3.1",
    "winston": "^3.17.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/elasticsearch": "^5.0.43",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "autoprefixer": "^10.4.14",
    "npm-force-resolutions": "^0.0.10",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.8.3"
  }
}
