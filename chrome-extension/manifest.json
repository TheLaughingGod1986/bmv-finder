{
  "manifest_version": 3,
  "name": "Property Intelligence Platform - Property Capture",
  "version": "1.0.0",
  "description": "Capture property data from real estate websites and add to your personalized Property Analyzer",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://*.rightmove.co.uk/*",
    "https://*.zoopla.co.uk/*",
    "https://*.onthemarket.com/*",
    "https://*.primelocation.com/*",
    "https://bmv-finder-j5x6cci85-bens-projects-11c93b15.vercel.app/*",
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.rightmove.co.uk/*",
        "https://*.zoopla.co.uk/*",
        "https://*.onthemarket.com/*",
        "https://*.primelocation.com/*",
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Property Intelligence Platform - Property Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
} 